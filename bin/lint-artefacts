#!/bin/sh
#
# Artefact frontmatter lint — enforces the artefact model against the registry
# (context/artefacts.toml). The model's rules and templates are in
# context/artefacts.md.
#
# Usage:
#   bin/lint-artefacts          lint staged *.md files (pre-commit mode)
#   bin/lint-artefacts --all    lint every tracked *.md file
#
# Checks (blocking): frontmatter present; kind registered; status legal for the
# kind's class; standing/binding files uppercase directly in their home;
# episodic/ephemeral files one registered engagement directory below theirs,
# named <kind>-<slug>.md with the prefix agreeing with frontmatter, and that
# directory under context/engagements/ for an open engagement or
# context/archive/ for a closed one, never the other way round. Registry checks
# (both modes): every engagement directory registered under whichever tree
# matches its status, every open engagement present on disk, every depends-on
# target registered, every engagement declaring `remits` (an explicit [] is
# legal, an absent key is not) in kebab-case with no duplicate value, no closed
# engagement holding an open episodic artefact, no
# tracked subdirectory under a topic beyond those the registry declares (the
# check reads tracked paths, not *.md, because a directory of .json/.txt is
# invisible to a markdown glob), and every open engagement that has started
# (holds a tracked file beyond its own plan or spec) holding a ledger-*.md, and
# STATE.md in shape: no fenced code blocks; a mandatory ordered §Next list
# pointing at item slugs; open items in the dated four-field bullet skeleton,
# token-capped, counted against a file cap and warned about when stale; item slugs
# naming open non-dormant engagements (optionally <engagement>/<thread>) or
# taking the item- prefix with 'Ledger: —'; dormant open engagements as
# roll-up lines instead — every number read from the registry's [state] table
# with defaults.
# Contents of a declared subdirectory are not artefacts and are skipped by
# every per-file check, as is everything under an agent-surface directory.
# Non-blocking: notices a remit value entering the register for the first time
# (staged mode only — the one moment a typo is cheap to catch, with no declared
# vocabulary to check membership against), lists ephemeral artefacts still open,
# and lists
# any *.md under the workspace root or context/ (outside tmp/) that git does not
# track — every check above reads tracked or staged paths only, so an untracked
# artefact is otherwise invisible by construction. Zero dependencies beyond
# POSIX sh, awk, and git — the registry TOML is a deliberately flat subset kept
# stable by dprint.
#
# A third mode, --remits [<remit>], is a read-only listing of the engagement
# register keyed by remit rather than a check: stdout only, no staged read.
#
# Exit codes: 0 clean, 1 findings, 2 usage/registry error.

set -u

REGISTRY="context/artefacts.toml"
ENGAGEMENTS_DIR="context/engagements"
ARCHIVE_DIR="context/archive"
[ -f "$REGISTRY" ] || { echo "error: $REGISTRY not found (run from the repository root)" >&2; exit 2; }

usage() { echo "usage: bin/lint-artefacts [--all | --remits [<remit>]]" >&2; exit 2; }

MODE="${1:-}"
REMIT_FILTER="${2:-}"
case "$MODE" in
"") [ $# -le 0 ] || usage; FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.md') ;;
--all) [ $# -le 1 ] || usage; FILES=$(git ls-files -- '*.md') ;;
--remits) [ $# -le 2 ] || usage; FILES="" ;;
*) usage ;;
esac

# Flatten the registry into lookup lines:
#   KC <kind> <class>   KH <kind> <home>   CS <class> <status...>
#   ES <engagement> <status>   ED <engagement> <dep...>   EA <engagement> <activity>
#   ER <engagement> <remit...>   SD <subdirectory> <tracked>   SC <state-key> <value>
TABLE=$(awk '
    /^\[/ { gsub(/[][ ]/, ""); n = split($0, s, "."); type = s[1]; name = s[2]; next }
    /^class = / { gsub(/"/, ""); print "KC", name, $3 }
    /^home = /  { gsub(/"/, ""); print "KH", name, $3 }
    /^status = / { if (type == "engagements") { gsub(/"/, ""); print "ES", name, $3 } }
    /^activity = / { if (type == "engagements") { gsub(/"/, ""); print "EA", name, $3 } }
    /^(max_items|field_tokens|rollup_tokens|next_entries|stale_days) = / {
        if (type == "state") print "SC", $1, $3
    }
    /^tracked = / { if (type == "subdirectory") print "SD", name, $3 }
    /^statuses = / {
        line = $0
        sub(/^statuses = \[/, "", line); sub(/\]$/, "", line)
        gsub(/[",]/, "", line)
        print "CS", name, line
    }
    /^depends-on = / {
        line = $0
        sub(/^depends-on = \[/, "", line); sub(/\]$/, "", line)
        gsub(/[",]/, "", line)
        print "ED", name, line
    }
    # An ER line with no trailing fields is an explicit empty list, which the
    # presence check below must tell apart from a missing key.
    /^remits = / {
        if (type != "engagements") next
        line = $0
        sub(/^remits = \[/, "", line); sub(/\]$/, "", line)
        gsub(/[",]/, "", line)
        print "ER", name, line
    }
' "$REGISTRY")
[ -n "$TABLE" ] || { echo "error: could not parse $REGISTRY" >&2; exit 2; }

lookup() { printf '%s\n' "$TABLE" | awk -v t="$1" -v n="$2" '$1==t && $2==n { $1=""; $2=""; sub(/^  /, ""); print; exit }'; }

# --remits: a read-only listing of the engagement register keyed by remit, on
# stdout, one line per (remit, engagement) pair. It lives here rather than in a
# tool of its own because this script already parses the register and a second
# copy of that parser would drift from it; a workspace without `aw` on PATH
# still has the listing. Engagements whose list is empty appear under the
# literal remit '-' so the listing is complete. Reads no staged file and writes
# no diagnostics: the mode is a query, not a gate.
if [ "$MODE" = "--remits" ]; then
    printf '%s\n' "$TABLE" | awk '$1 == "ER" { $1 = ""; sub(/^ /, ""); print }' |
        while read -r name remits; do
            estatus=$(lookup ES "$name")
            eactivity=$(lookup EA "$name")
            [ -n "$eactivity" ] || eactivity="active"
            if [ "$estatus" = "open" ] && [ -d "$ENGAGEMENTS_DIR/$name" ]; then
                edir="$ENGAGEMENTS_DIR/$name"
            elif [ "$estatus" != "open" ] && [ -d "$ARCHIVE_DIR/$name" ]; then
                edir="$ARCHIVE_DIR/$name"
            else
                edir="-"
            fi
            [ -n "$remits" ] || remits="-"
            for r in $remits; do
                printf '%s\t%s\t%s\t%s\t%s\n' "$r" "$name" "$estatus" "$eactivity" "$edir"
            done
        done | LC_ALL=C sort | awk -F'\t' -v f="$REMIT_FILTER" 'f == "" || $1 == f'
    exit 0
fi

# Subdirectory names the registry declares as tracked. tmp/ is declared
# untracked and so never reaches a tracked path — nothing to permit.
TRACKED_SUBDIRS=$(printf '%s\n' "$TABLE" | awk '$1 == "SD" && $3 == "true" { print $2 }' | tr '\n' ' ')

# Echoes the subdirectory a path sits under inside its topic, empty if the path
# is a topic-level file or outside the engagements/archive trees.
nonentity_subdir() {
    case "$1" in
    "$ENGAGEMENTS_DIR"/*) rel="${1#"$ENGAGEMENTS_DIR"/}" ;;
    "$ARCHIVE_DIR"/*) rel="${1#"$ARCHIVE_DIR"/}" ;;
    *) return 0 ;;
    esac
    printf '%s\n' "$rel" | awk -F/ 'NF > 2 { print $2 }'
}

fm_get() {
    awk -v key="$2:" '
        NR == 1 { if ($0 != "---") exit; next }
        /^---$/ { exit }
        $1 == key { print $2; exit }
    ' "$1"
}

FAIL=0
OPEN_EPHEMERA=""

for f in $FILES; do
    # Agent surfaces are out of scope by directory. A skill, a subagent
    # definition or a command is markdown carrying frontmatter of a foreign
    # schema — it declares `name`, never `kind` — so the model has nothing to say
    # about it. By directory and not by filename deliberately: the whole tree
    # belongs to the tooling, and a `SKILL.md` basename rule would also excuse a
    # stray one sitting inside context/. Skills reaching a workspace by symlink
    # from a member repo are invisible here anyway (git tracks the link, not the
    # target), so this is what admits workspace-local ones kept in this history.
    case "$f" in .agents/* | .claude/* | .skills/*) continue ;; esac
    case "$(basename "$f")" in README.md | AGENTS.md | CLAUDE.md | CONTRACT.md | CHANGELOG.md) continue ;; esac
    [ -f "$f" ] || continue

    # Anything below a topic directory is not an artefact: no kind, no status, no
    # naming rule. Without this, a markdown transcript in attachments/ is
    # rejected by the path check, which admits exactly one directory below the
    # home. Whether the directory is permitted at all is the registry check's
    # business, not this loop's.
    [ -z "$(nonentity_subdir "$f")" ] || continue

    if [ "$(head -n 1 "$f")" != "---" ]; then
        echo "$f: missing frontmatter"
        FAIL=1
        continue
    fi

    kind=$(fm_get "$f" kind)
    status=$(fm_get "$f" status)

    if [ -z "$kind" ]; then
        echo "$f: frontmatter has no 'kind'"
        FAIL=1
        continue
    fi
    class=$(lookup KC "$kind")
    if [ -z "$class" ]; then
        echo "$f: kind '$kind' not in registry"
        FAIL=1
        continue
    fi

    if [ -z "$status" ]; then
        echo "$f: frontmatter has no 'status'"
        FAIL=1
    else
        legal=$(lookup CS "$class")
        case " $legal " in
        *" $status "*) ;;
        *)
            echo "$f: status '$status' illegal for class '$class' (kind '$kind'; legal: $legal)"
            FAIL=1
            ;;
        esac
    fi

    home=$(lookup KH "$kind")
    case "$class" in
    standing | binding)
        # artefacts.md is the registry's prose companion — lowercase by design
        # (data and reference, not every-session signage).
        if [ "$f" != "context/artefacts.md" ]; then
            expr "$f" : "$home/[A-Z0-9_][A-Z0-9_]*\.md\$" > /dev/null ||
                { echo "$f: kind '$kind' belongs directly in $home/ under an uppercase name, words separated by underscore"; FAIL=1; }
        fi
        ;;
    *)
        loc=""
        if expr "$f" : "$ENGAGEMENTS_DIR/[^/][^/]*/[^/][^/]*\.md\$" > /dev/null; then
            loc="$ENGAGEMENTS_DIR"
        elif expr "$f" : "$ARCHIVE_DIR/[^/][^/]*/[^/][^/]*\.md\$" > /dev/null; then
            loc="$ARCHIVE_DIR"
        fi
        if [ -n "$loc" ]; then
            topic=$(printf '%s\n' "$f" | awk -F/ '{ print $(NF-1) }')
            base=$(basename "$f")
            estatus=$(lookup ES "$topic")
            if [ -z "$estatus" ]; then
                echo "$f: engagement '$topic' not in registry"
                FAIL=1
            elif [ "$loc" = "$ENGAGEMENTS_DIR" ] && [ "$estatus" = "closed" ]; then
                echo "$f: engagement '$topic' is closed, belongs under $ARCHIVE_DIR/$topic/ not $ENGAGEMENTS_DIR/$topic/"
                FAIL=1
            elif [ "$loc" = "$ARCHIVE_DIR" ] && [ "$estatus" != "closed" ]; then
                echo "$f: engagement '$topic' is not closed, belongs under $ENGAGEMENTS_DIR/$topic/ not $ARCHIVE_DIR/$topic/"
                FAIL=1
            fi
            case "$base" in
            "$kind"-*) ;;
            *)
                echo "$f: filename must carry its kind ('$kind-<slug>.md', got '$base')"
                FAIL=1
                ;;
            esac
        else
            echo "$f: kind '$kind' belongs in $ENGAGEMENTS_DIR/<engagement>/$kind-<slug>.md (or $ARCHIVE_DIR/ once the engagement is closed)"
            FAIL=1
        fi
        ;;
    esac

    if [ "$class" = "ephemeral" ] && [ "$status" = "open" ]; then
        OPEN_EPHEMERA="$OPEN_EPHEMERA $f"
    fi
done

# Registry-level checks, independent of which files are staged.
for topic in $(git ls-files "$ENGAGEMENTS_DIR" | awk -F/ 'NF > 3 { print $3 }' | sort -u); do
    estatus=$(lookup ES "$topic")
    if [ -z "$estatus" ]; then
        echo "$ENGAGEMENTS_DIR/$topic/: engagement not in registry"
        FAIL=1
    elif [ "$estatus" = "closed" ]; then
        echo "$ENGAGEMENTS_DIR/$topic/: engagement is closed, belongs under $ARCHIVE_DIR/$topic/"
        FAIL=1
    fi
done
for topic in $(git ls-files "$ARCHIVE_DIR" | awk -F/ 'NF > 3 { print $3 }' | sort -u); do
    estatus=$(lookup ES "$topic")
    if [ -z "$estatus" ]; then
        echo "$ARCHIVE_DIR/$topic/: engagement not in registry"
        FAIL=1
    elif [ "$estatus" != "closed" ]; then
        echo "$ARCHIVE_DIR/$topic/: engagement is not closed, belongs under $ENGAGEMENTS_DIR/$topic/"
        FAIL=1
    fi
done
printf '%s\n' "$TABLE" | awk '$1 == "ES" { print $2, $3 }' | while read -r name estatus; do
    if [ "$estatus" = "open" ] && [ -z "$(git ls-files "$ENGAGEMENTS_DIR/$name")" ]; then
        echo "registry: open engagement '$name' has no directory under $ENGAGEMENTS_DIR/"
    fi
done | grep . && FAIL=1
# Ledger-start predicate: an open engagement has "started" once a tracked file
# other than its own plan or spec exists. Started with no ledger-*.md present
# is a run with no record. Subdirectory contents (attachments/tmp) are not
# artefacts (nonentity_subdir) and are skipped, same as every per-file check
# above.
printf '%s\n' "$TABLE" | awk '$1 == "ES" && $3 == "open" { print $2 }' | while read -r name; do
    has_other=0
    has_ledger=0
    for f in $(git ls-files "$ENGAGEMENTS_DIR/$name"); do
        [ -z "$(nonentity_subdir "$f")" ] || continue
        case "$(basename "$f")" in
        plan-*.md | spec-*.md) ;;
        ledger-*.md) has_ledger=1 ;;
        *) has_other=1 ;;
        esac
    done
    if [ "$has_other" = 1 ] && [ "$has_ledger" = 0 ]; then
        echo "$ENGAGEMENTS_DIR/$name/: engagement has started (holds a file beyond plan/spec) but has no ledger-*.md"
    fi
done | grep . && FAIL=1
printf '%s\n' "$TABLE" | awk '$1 == "ED" { for (i = 3; i <= NF; i++) print $2, $i }' | while read -r name dep; do
    [ -n "$(lookup ES "$dep")" ] ||
        echo "registry: engagement '$name' depends on unregistered '$dep'"
done | grep . && FAIL=1
# Remits: which standing areas of responsibility an engagement's work counts
# against. Required on every entry, open or closed, because the whole value is
# retrospective collection and that only works when every entry is tagged; an
# explicit [] is the adopter deciding an engagement sits under none, so an
# omission is an error rather than a silent "unclassified". The vocabulary is
# the adopter's, so the shape is checked and the membership is not.
printf '%s\n' "$TABLE" | awk -v q="'" '
    $1 == "ES" { es[$2] = 1; order[++n] = $2 }
    $1 == "ER" {
        er[$2] = 1
        for (i = 3; i <= NF; i++) list[$2] = list[$2] " " $i
    }
    END {
        for (i = 1; i <= n; i++) {
            name = order[i]
            if (!(name in er)) {
                print "registry: engagement " q name q " has no remits key (required; [] means none)"
                continue
            }
            cnt = split(list[name], v, " ")
            for (j = 1; j <= cnt; j++) {
                if (v[j] !~ /^[a-z0-9]+(-[a-z0-9]+)*$/)
                    print "registry: engagement " q name q " remit " q v[j] q " is not kebab-case"
                if (seen[name SUBSEP v[j]]++ == 1)
                    print "registry: engagement " q name q " lists remit " q v[j] q " twice"
            }
        }
    }
' | grep . && FAIL=1
# Non-entity directories: a topic may hold only the tracked subdirectories the
# registry declares. Undeclared ones grow unnoticed precisely because a markdown
# glob never sees them.
{ git ls-files "$ENGAGEMENTS_DIR" | awk -F/ 'NF > 4 { print "'"$ENGAGEMENTS_DIR"'", $3, $4 }'; git ls-files "$ARCHIVE_DIR" | awk -F/ 'NF > 4 { print "'"$ARCHIVE_DIR"'", $3, $4 }'; } |
    sort -u | while read -r dir topic sub; do
        case " $TRACKED_SUBDIRS " in
        *" $sub "*) ;;
        *) echo "$dir/$topic/$sub/: undeclared subdirectory (registry permits: ${TRACKED_SUBDIRS% })" ;;
        esac
    done | grep . && FAIL=1
# Closure hygiene: a non-open engagement must hold no open episodic artefact —
# closing an engagement closes its plans, specs, and ledger.
printf '%s\n' "$TABLE" | awk '$1 == "ES" && $3 != "open" { print $2 }' | while read -r name; do
    for f in $(git ls-files "$ENGAGEMENTS_DIR/$name" "$ARCHIVE_DIR/$name"); do
        case "$f" in *.md) ;; *) continue ;; esac
        [ -z "$(nonentity_subdir "$f")" ] || continue
        [ "$(lookup KC "$(fm_get "$f" kind)")" = "episodic" ] || continue
        [ "$(fm_get "$f" status)" = "open" ] &&
            echo "$f: episodic artefact still 'open' under closed engagement '$name' (close it with the engagement)"
    done
done | grep . && FAIL=1

# STATE.md shape. The rules read the file on disk in both modes, because the
# singleton is always live, and every number comes from the registry [state]
# table with defaults supplied here. No fenced code blocks anywhere —
# verbatim output belongs to the owning ledger. §Next is a mandatory ordered
# list, capped in entries, each naming an existing item slug — pointers, never
# prose. Every entry under '## Open items' is the four-field bullet skeleton
# with token caps (a token is one whitespace-delimited field), a (YYYY-MM-DD)
# last-rewritten date in the heading — warned about past stale_days, never
# blocked: a block would fire on unrelated commits and invite date-bumping,
# corrupting the very signal — and a slug that
# names an open non-dormant engagement — optionally as <engagement>/<thread>,
# several items per engagement — unless it takes the reserved item- prefix,
# which requires 'Ledger: —' and marks a no-topic subject (its slug a
# permanent address). A dormant open engagement holds one token-capped
# roll-up line under '## Dormant engagements' instead of an item, and total
# items are capped at max_items so a thread split costs a slot.
STATE=context/STATE.md
if [ -f "$STATE" ]; then
    state_cfg() {
        printf '%s\n' "$TABLE" | awk -v k="$1" -v d="$2" '
            BEGIN { v = d } $1 == "SC" && $2 == k { v = $3 } END { print v }'
    }
    MAX_ITEMS=$(state_cfg max_items 12)
    FIELD_TOKENS=$(state_cfg field_tokens 50)
    ROLLUP_TOKENS=$(state_cfg rollup_tokens 25)
    NEXT_ENTRIES=$(state_cfg next_entries 8)
    STALE_DAYS=$(state_cfg stale_days 30)

    if grep -q '^[[:space:]]*```' "$STATE"; then
        echo "$STATE: fenced code block — verbatim output belongs in the owning ledger"
        FAIL=1
    fi
    # The shape rules only run inside the sections they parse, so a renamed
    # heading would silently disable them; require each to exist. §Dormant
    # engagements is required only by the coupling below, once a dormant open
    # engagement exists.
    for sec in 'Open items' 'Next'; do
        grep -Eq "^## ([0-9]+\. )?$sec\$" "$STATE" || {
            echo "$STATE: no '## $sec' section — the shape rules did not run"
            FAIL=1
        }
    done
    STATE_ITEMS=$(awk -v ftok="$FIELD_TOKENS" -v rtok="$ROLLUP_TOKENS" \
        -v nmax="$NEXT_ENTRIES" -v imax="$MAX_ITEMS" -v stale="$STALE_DAYS" \
        -v today="$(date +%Y-%m-%d)" '
        # Days since an ISO date, via Julian day numbers — pure arithmetic, so
        # it needs neither GNU date nor gawk mktime.
        function jdn(ds,    p, a, y, m) {
            split(ds, p, "-")
            a = int((14 - p[2]) / 12); y = p[1] + 4800 - a; m = p[2] + 12 * a - 3
            return p[3] + int((153 * m + 2) / 5) + 365 * y + int(y / 4) - \
                int(y / 100) + int(y / 400) - 32045
        }
        BEGIN { tj = jdn(today) }
        /^## / {
            doflush(); rflush()
            innext  = ($0 ~ /^## ([0-9]+\. )?Next$/)
            initems = ($0 ~ /^## ([0-9]+\. )?Open items$/)
            indorm  = ($0 ~ /^## ([0-9]+\. )?Dormant engagements$/)
            next
        }
        innext {
            if ($0 ~ /^[0-9]+\. /)                              { nref++; print "NEXTREF " $2; next }
            if ($0 ~ /^[[:space:]]+[^[:space:]]/ && nref)       next
            if ($0 ~ /^[[:space:]]*$/)                          next
            print "BAD §Next: free text outside the ordered list"
            next
        }
        indorm {
            if ($0 ~ /^- [a-z0-9-]+:/) { rflush(); rslug = $2; sub(/:$/, "", rslug); rn = NF - 1; next }
            if ($0 ~ /^[[:space:]]+[^[:space:]]/ && rslug != "") { rn += NF; next }
            if ($0 ~ /^[[:space:]]*$/)                          next
            print "BAD §Dormant engagements: line is not a roll-up bullet"
            next
        }
        !initems { next }
        /^### / { doflush(); slug = $2; d = $3; gsub(/[()]/, "", d); f = ""; n = x = b = l = 0; next }
        slug == "" { next }
        /^- Now:/     { f = "n"; n += NF - 2; next }
        /^- Next:/    { f = "x"; x += NF - 2; next }
        /^- Blocked:/ { f = "b"; b += NF - 2; next }
        /^- Ledger:/  { f = "l"; l++; if ($0 ~ /^- Ledger:[[:space:]]*—[[:space:]]*$/) nt = 1; next }
        /^[[:space:]]+[^[:space:]]/ {
            if      (f == "n") n += NF
            else if (f == "x") x += NF
            else if (f == "b") b += NF
            else if (f == "l") l++
            else print "BAD " slug ": free text outside the four fields"
            next
        }
        /^[[:space:]]*$/ { next }
        { print "BAD " slug ": free text outside the four fields" }
        function doflush(    age, base) {
            if (slug == "") return
            if (!n || !x || !b || !l)
                print "BAD " slug ": missing field (need Now/Next/Blocked/Ledger)"
            if (n > ftok) print "BAD " slug ": Now exceeds " ftok " tokens (" n ")"
            if (x > ftok) print "BAD " slug ": Next exceeds " ftok " tokens (" x ")"
            if (b > ftok) print "BAD " slug ": Blocked exceeds " ftok " tokens (" b ")"
            if (l > 1)  print "BAD " slug ": Ledger exceeds 1 line"
            if (d !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)
                print "BAD " slug ": heading carries no (YYYY-MM-DD) last-rewritten date"
            else {
                age = tj - jdn(d)
                if (age > stale) print "STALE " slug " " age
            }
            if (slug ~ /^item-/) {
                if (nt) print "NOTOPIC " slug
                else print "BAD " slug ": item- prefix without Ledger: —"
            } else if (nt) {
                print "BAD " slug ": Ledger: — on an unprefixed slug — a no-topic subject takes the item- prefix"
            } else {
                base = slug; sub(/\/.*/, "", base)
                print "SLUG " base
            }
            print "ITEM " slug
            items++
            slug = ""; nt = 0; d = ""
        }
        function rflush() {
            if (rslug == "") return
            if (rn > rtok)
                print "BAD " rslug ": roll-up line exceeds " rtok " tokens (" rn ")"
            print "ROLLUP " rslug
            rslug = ""; rn = 0
        }
        END {
            doflush(); rflush()
            if (items > imax)
                print "BAD file: " items " items exceed the max_items cap (" imax ") — a slot must be earned"
            if (nref > nmax)
                print "BAD §Next: " nref " entries exceed the next_entries cap (" nmax ")"
        }
    ' "$STATE")
    printf '%s\n' "$STATE_ITEMS" | while read -r tag rest; do
        case "$tag" in
        BAD) echo "$STATE: $rest" ;;
        SLUG)
            estatus=$(lookup ES "$rest")
            if [ "$estatus" != "open" ]; then
                echo "$STATE: item '$rest' names an engagement that is not open (status: ${estatus:-unregistered}) — closing an engagement removes its item, residue routed first"
            elif [ "$(lookup EA "$rest")" = "dormant" ]; then
                echo "$STATE: item '$rest' names a dormant engagement — one roll-up line under §Dormant engagements instead"
            fi
            ;;
        ROLLUP)
            estatus=$(lookup ES "$rest")
            if [ "$estatus" != "open" ]; then
                echo "$STATE: roll-up '$rest' names an engagement that is not open (status: ${estatus:-unregistered}) — closing an engagement removes its line, residue routed first"
            elif [ "$(lookup EA "$rest")" != "dormant" ]; then
                echo "$STATE: roll-up '$rest' names an engagement the registry does not declare dormant — an active engagement holds an item"
            fi
            ;;
        NEXTREF)
            printf '%s\n' "$STATE_ITEMS" | grep -qx "ITEM $rest" ||
                echo "$STATE: §Next names '$rest', which is no item slug — a stale priority"
            ;;
        esac
    done | grep . && FAIL=1
    # Staleness warns, never blocks: a block would fire on whoever commits
    # next and invite a date bump without a real re-read.
    STALE_LINES=$(printf '%s\n' "$STATE_ITEMS" | awk '$1 == "STALE" { print "  " $2 " (" $3 " days)" }')
    if [ -n "$STALE_LINES" ]; then
        echo "warning: stale open items — re-read each against reality and rewrite or confirm it; if the refresh is real work, route it into §Next:" >&2
        printf '%s\n' "$STALE_LINES" >&2
    fi
    # The reverse coupling: an open engagement absent from both tiers is
    # invisible to a resuming session — the same gap that once let a run go
    # unrecorded.
    printf '%s\n' "$TABLE" | awk '$1 == "ES" && $3 == "open" { print $2 }' | while read -r name; do
        if [ "$(lookup EA "$name")" = "dormant" ]; then
            printf '%s\n' "$STATE_ITEMS" | grep -qx "ROLLUP $name" ||
                echo "$STATE: dormant open engagement '$name' has no roll-up line under §Dormant engagements"
        else
            printf '%s\n' "$STATE_ITEMS" | grep -qx "SLUG $name" ||
                echo "$STATE: open engagement '$name' has no item under Open items"
        fi
    done | grep . && FAIL=1
fi

# Untracked *.md at the root or under context/: the checks above enumerate
# tracked or staged paths only, so an artefact that was never `git add`-ed is
# invisible to every one of them. tmp/ is untracked by design and excluded here
# to keep the noise floor low; a declared subdirectory's contents are not
# artefacts (nonentity_subdir), so its own untracked .md files are skipped the
# same way the per-file loop skips them.
UNTRACKED_MD=""
CANDIDATES=$(
    { find . -maxdepth 1 -name '*.md'; find context -name '*.md' -not -path '*/tmp/*'; } 2> /dev/null |
        sed 's|^\./||' | sort -u
)
for f in $CANDIDATES; do
    [ -z "$(nonentity_subdir "$f")" ] || continue
    git ls-files --error-unmatch -- "$f" > /dev/null 2>&1 || UNTRACKED_MD="$UNTRACKED_MD $f"
done

# First appearance of a remit value, staged mode only. With no declared
# vocabulary there is no membership to enforce, so this is the one moment a typo
# or a synonym is cheap to catch: the author still remembers typing it.
# Non-blocking by construction — a new remit is legitimate and the register is
# the workspace's to grow — so it never touches FAIL. Skipped on a repository
# with no HEAD, where every value is a first appearance and the notice is noise.
remit_values() {
    awk '
        /^\[/ { gsub(/[][ ]/, ""); split($0, s, "."); type = s[1]; next }
        /^remits = / {
            if (type != "engagements") next
            line = $0
            sub(/^remits = \[/, "", line); sub(/\]$/, "", line)
            gsub(/[",]/, "", line)
            m = split(line, v, " ")
            for (i = 1; i <= m; i++) print v[i]
        }
    '
}

if [ "$MODE" = "" ] && git rev-parse --verify -q HEAD > /dev/null &&
    git diff --cached --name-only --diff-filter=ACMR -- "$REGISTRY" | grep -q .; then
    OLD_REMITS=$(git show "HEAD:$REGISTRY" 2> /dev/null | remit_values | LC_ALL=C sort -u)
    NEW_REMITS=$(git show ":$REGISTRY" | remit_values | LC_ALL=C sort -u)
    EXISTING=$(printf '%s\n' "$OLD_REMITS" | grep . | paste -sd, - | sed 's/,/, /g')
    [ -n "$EXISTING" ] || EXISTING="none"
    # The existing set reaches awk through the environment, not -v: a -v value
    # is scanned for escape sequences and a literal newline ends it there.
    printf '%s\n' "$NEW_REMITS" | OLD_REMITS="$OLD_REMITS" awk '
        BEGIN { n = split(ENVIRON["OLD_REMITS"], o, "\n"); for (i = 1; i <= n; i++) seen[o[i]] = 1 }
        $0 != "" && !($0 in seen)
    ' | while read -r r; do
        echo "notice: remit '$r' appears for the first time in the register (existing: $EXISTING)" >&2
    done
fi

if [ -n "$OPEN_EPHEMERA" ]; then
    echo "warning: ephemeral artefacts still open (graduate or expire when their unit lands):" >&2
    for f in $OPEN_EPHEMERA; do echo "  $f" >&2; done
fi

if [ -n "$UNTRACKED_MD" ]; then
    echo "warning: untracked artefacts (invisible to every check above until 'git add'):" >&2
    for f in $UNTRACKED_MD; do echo "  $f" >&2; done
fi

exit $FAIL
